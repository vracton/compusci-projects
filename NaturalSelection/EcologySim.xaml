<Window x:Class="NaturalSelection.EcologySim"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NaturalSelection"
        mc:Ignorable="d"
        Title="Ecology Simulation" WindowState="Maximized" Background="Black">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Background="Gray" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Name="Start_Button" Click="Start_Button_Click"  Grid.Column="0">
                Start
            </Button>
            <StackPanel Orientation="Horizontal" Grid.Column="1">
                <TextBlock Text="Time per turn (s)" VerticalAlignment="Center" Margin="10" />
                <TextBox Name="TimeIncrementSlider" TextChanged="TimeIncrementSlider_TextChanged"  Width="40" Margin="10"/>

                <TextBlock Text="Time: " VerticalAlignment="Center" />
                <TextBlock x:Name="TimeText" Margin="10" VerticalAlignment="Center" Text="0 days" />

                <Button Name="Save_Button" Width="50" Click="Save_Button_Click">Save</Button>
                <Button Name="Clipboard_Button" Width="100" Click="Clipboard_Button_Click">Screenshot</Button>
            </StackPanel>
        </Grid>

        <ContentControl Name="ArenaSpot" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="-5,0,5,0" Grid.Row="1"/>
    </Grid>
</Window>
